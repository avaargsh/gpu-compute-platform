# Canonical Go control-plane configuration

# Management-plane PostgreSQL. Leave empty only for explicit in-memory local tests.
DATABASE_URL=postgres://gpu:gpu@postgres:5432/gpu_platform?sslmode=disable

# Cluster Agent identity and control-plane endpoint.
CLUSTER_ID=local-cluster
CONTROL_PLANE_URL=http://control-plane:8080

# Used by docker compose --profile agent. Point at a kubeconfig readable by Docker.
KUBECONFIG=/home/user/.kube/config

# Optional stable process identity for HA / takeover experiments.
AGENT_INSTANCE_ID=

# Cluster Agent reconcile cadence.
AGENT_SYNC_INTERVAL=15s

# Provider selection is NOT an environment variable.
# The management plane freezes it in ClusterBinding.provider.
# Current supported provider adapter: kueue.
