{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "portal:dev": "vite --config vite.portal.config.ts --open /portal.html",
    "portal:build": "vue-tsc -p tsconfig.portal.json --noEmit && vite build --config vite.portal.config.ts",
    "portal:preview": "vite preview --config vite.portal.config.ts",
    "portal:test": "node --experimental-strip-types --test tests/*.test.mts",
    "management:dev": "vite --config vite.management.config.ts --open /management.html",
    "management:test": "node --experimental-strip-types --test tests/management*.test.mts",
    "management:build": "vue-tsc -p tsconfig.management.json --noEmit && vite build --config vite.management.config.ts"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "axios": "^1.11.0",
    "echarts": "^6.0.0",
    "element-plus": "^2.11.2",
    "pinia": "^3.0.3",
    "socket.io-client": "^4.8.1",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.7.0",
    "typescript": "~5.8.3",
    "unplugin-auto-import": "^20.1.0",
    "unplugin-vue-components": "^29.0.0",
    "vite": "^7.1.2",
    "vue-tsc": "^3.0.5"
  }
}
