{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "lucide-react": ["./node_modules/lucide-react/dist/lucide-react.d.ts"]
    },
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "src/vite-env.d.ts",
    "src/types/lucide-react.d.ts",
    "src/lib/**/*",
    "src/hooks/**/*",
    "src/stores/useAuthStore.ts",
    "src/stores/useTaskStore.ts",
    "src/stores/useGpuStore.ts",
    "src/stores/useCostStore.ts",
    "src/services/authApi.ts",
    "src/services/taskApi.ts",
    "src/services/gpuApi.ts",
    "src/services/costApi.ts",
    "src/services/systemApi.ts",
    "src/services/index.ts",
    "src/types/**/*",
    "src/components/**/*",
    "src/pages/**/*",
    "src/layouts/**/*",
    "src/routes/**/*",
    "src/main.tsx",
    "src/App.tsx",
    "src/index.css"
  ],
  "exclude": [
    "src/**/*.vue",
    "src/management/**",
    "src/portal/**",
    "src/views/**",
    "src/router/index.ts",
    "src/main.ts",
    "src/App.vue",
    "src/services/api.ts",
    "src/services/websocket.ts",
    "src/stores/costStore.ts",
    "src/stores/gpuStore.ts",
    "src/stores/taskStore.ts",
    "src/stores/userStore.ts"
  ]
}
