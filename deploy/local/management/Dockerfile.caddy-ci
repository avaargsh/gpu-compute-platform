# Local CI-only hardened Caddy runtime. The upstream official image ships
# /usr/bin/caddy with cap_net_bind_service=+ep, which fails execve under
# --cap-drop ALL + no-new-privileges even though our listener is >1024.
# Remove ONLY that unnecessary file capability; retain the upstream server.
# This is not a production image or signed release.
FROM caddy:2.11.6-alpine@sha256:d44355d3c2149dc580ce2cac735955d1c08d3d00882c30489c241aa51a5c10d9
USER root
RUN apk add --no-cache libcap && \
    setcap -r /usr/bin/caddy && \
    test -z "$(getcap /usr/bin/caddy)"
USER 65532:65532
